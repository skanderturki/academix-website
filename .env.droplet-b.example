# =============================================================================
# Droplet B — 165.232.175.224  (jahiz.tn · academix.tn · pmp · gallery · bacinfo)
# Copy to `.env.droplet-b` on the droplet and fill in. Never commit the real file.
#   cp .env.droplet-b.example .env.droplet-b
#   docker compose -f docker-compose.droplet-b.yml --env-file .env.droplet-b up -d
#
# Vars marked [REQUIRED] use ${VAR:?} in the compose file — compose refuses to
# start if they're empty. Generate secrets with:  openssl rand -hex 32
# =============================================================================

# --- pmp.academix.tn (PMP Learning Platform) -------------------------------
PMP_MONGODB_URI=                 # [REQUIRED]  MongoDB Atlas SRV URI (PMP stays on Atlas)
PMP_JWT_SECRET=                  # [REQUIRED]  openssl rand -hex 32
PMP_RESEND_API_KEY=              # optional — verification/notification emails
PMP_RESEND_FROM=PMP Learn <pmp@jahiz.tn>   # send from the verified jahiz.tn domain


# --- gallery.jahiz.tn (nadart-evo) -----------------------------------------
NADART_JWT_SECRET=               # [REQUIRED]  openssl rand -hex 32
NADART_ADMIN_EMAIL=              # [REQUIRED]  gallery admin login
NADART_ADMIN_PASSWORD=           # [REQUIRED]  strong password
# Google sign-in (optional). Baked into the client bundle at BUILD time, so it
# must be present when you build the gallery image.
NADART_VITE_GOOGLE_CLIENT_ID=
NADART_GOOGLE_CLIENT_ID=
# Contact form -> Resend email to the gallery owner (ADMIN_EMAIL unless set).
NADART_RESEND_API_KEY=
NADART_RESEND_FROM=NadArt Gallery <gallery@jahiz.tn>
NADART_CONTACT_TO_EMAIL=

# --- jahiz.tn (contact form via Resend) ------------------------------------
JAHIZ_RESEND_API_KEY=            # required for the jahiz.tn contact form to work
JAHIZ_RESEND_FROM=Jahiz <noreply@jahiz.tn>
JAHIZ_CONTACT_TO_EMAIL=contact@jahiz.tn
# Optional preview gate — leave SITE_PASSWORD blank to keep the site public.
JAHIZ_SITE_USERNAME=preview
JAHIZ_SITE_PASSWORD=
JAHIZ_ANALYTICS_TOKEN=           # token to read /api/stats. Blank disables readout.

# --- Unified analytics dashboard at jahiz.tn/admin -------------------------
# Disabled until ADMIN_PASSWORD is set; reads academix.tn's stats over the
# shared network with MAIN_ANALYTICS_TOKEN.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- academix.tn (contact form + quote relay) ------------------------------
MAIN_RESEND_API_KEY=             # required for the academix.tn contact form
MAIN_RESEND_FROM=Academix <academix@jahiz.tn>
MAIN_CONTACT_TO_EMAIL=academix@jahiz.tn
# Shared with the platform (ORDER_INTAKE_SECRET there): signs each quote request
# this site relays to admin.academix.tn. Generate once: openssl rand -hex 32
MAIN_ORDER_INTAKE_SECRET=
MAIN_SITE_USERNAME=preview
MAIN_SITE_PASSWORD=
MAIN_ANALYTICS_TOKEN=            # token to read /api/stats. Blank disables readout.

# --- info.baximize.com (bacinfo) -------------------------------------------
# TODO: add vars here once bacinfo is relocated and its service is uncommented
# in docker-compose.droplet-b.yml.
